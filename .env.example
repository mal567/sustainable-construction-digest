# Local development only. Managed deployments authenticate with a
# service-account token injected by the platform.
MISTRAL_API_KEY=

# Amazon SES SMTP credentials (required to send; sending is skipped when
# SES_SMTP_PASSWORD is unset)
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Optional: SES configuration set name; when set, adds the
# X-SES-CONFIGURATION-SET header so open/click events reach your
# event destination.
SES_CONFIGURATION_SET=

# Optional: adds List-Unsubscribe headers pointing at this URL.
SES_LIST_UNSUBSCRIBE_URL=
